# Conexão PostgreSQL 17 + PostGIS 3.5
DATABASE_URL=postgresql+psycopg://territorio:territorio@localhost:5432/territorio

# Diretório base de dados (reference, raw, manual, reports)
DATA_DIR=./data

# Portal da Transparência (CGU) - Obtenha gratuitamente em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_RATE_PER_MIN=80

# Cliente HTTP do ETL
HTTP_TIMEOUT_S=60

# Configuração da API FastAPI
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
