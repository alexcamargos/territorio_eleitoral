# ==============================================================================
# Território Eleitoral — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambientes Virtuais e Gerenciadores de Pacotes Python
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.uv/

# ------------------------------------------------------------------------------
# 2. Caches e Artefatos Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
build/
dist/
wheels/

# ------------------------------------------------------------------------------
# 3. Testes, Linters e Cobertura
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml

# ------------------------------------------------------------------------------
# 4. Dados Brutos, Caches de ETL e Relatórios Não Versionados
# ------------------------------------------------------------------------------
# Ignora o conteúdo de data/raw, data/manual e data/reports mantendo a árvore
**/data/raw/*
!**/data/raw/.gitkeep
**/data/manual/*
!**/data/manual/.gitkeep
**/data/reports/*
!**/data/reports/.gitkeep

# Arquivos temporários e parciais de download
*.tmp
*.temp
*.part
*.crdownload
.temp/
.tmp/

# Formatos Geoespaciais, Big Data e Dumps locais (evita vazamento acidental fora de data/raw)
*.parquet
*.geoparquet
*.pmtiles
*.mbtiles
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.sqlite
*.sqlite3
*.duckdb
*.dump
*.sql.gz

# Notebooks e exploração de dados
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 5. Frontend (Preact + Vite + TypeScript)
# ------------------------------------------------------------------------------
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Variáveis de Ambiente e Segredos
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 7. Logs de Execução
# ------------------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------------------
# 8. Sistema Operacional e IDEs
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vs/
*.suo
*.user
